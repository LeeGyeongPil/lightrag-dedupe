# Copy to .env if you want; the tool reads plain environment variables (it does not load .env itself).

# Screen language: en or ko (--lang wins, then this, then LC_ALL / LC_MESSAGES / LANG).
LIGHTRAG_DEDUPE_LANG=

# Only for `apply --server`, and only if your LightRAG server has an API key enabled.
# Sent as the X-API-Key header. Leave empty otherwise. Never commit a real value.
LIGHTRAG_API_KEY=
